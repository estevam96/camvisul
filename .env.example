# ==============================================================================
# CamVisul - Configurações do Ambiente
# Copie este arquivo para .env para customizar (opcional)
# ==============================================================================

# Porta do Servidor Web CamVisul (Padrão: 3000)
PORT=3000

# Endereço IP padrão da câmera na rede local (opcional)
# Se preenchido, será utilizado como padrão no login da interface
# DEFAULT_CAMERA_IP=192.168.1.100

# Porta RTSP padrão da câmera (Padrão: 554)
DEFAULT_CAMERA_PORT=554

# Usuário padrão da câmera (Padrão: admin)
DEFAULT_CAMERA_USER=admin

# IPs alternativos para contingência automática de DHCP (separados por vírgula)
# Caso a câmera mude de IP via roteador, o servidor testará estes endereços automaticamente
# CAMERA_FALLBACK_IPS=192.168.1.101,192.168.1.102
