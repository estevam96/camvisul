# ==============================================================================
# CamVisul - Configurações do Ambiente
# Copie este arquivo para .env para customizar (opcional)
# ==============================================================================

# Porta do Servidor Web CamVisul (Padrão: 3000 com auto-fallback se ocupada)
PORT=3000

# Chave mestra opcional para criptografia simétrica AES-256-GCM das senhas no SQLite
# Se não definida, o sistema gerará automaticamente uma chave segura em data/.secret.key
# APP_SECRET_KEY=sua-chave-secreta-super-segura-de-32-caracteres

# ------------------------------------------------------------------------------
# Configurações Legadas de Câmera Inicial (Opcional)
# Se o banco SQLite (data/camvisul.db) estiver vazio, estes valores serão
# migrados automaticamente como a primeira câmera cadastrada:
# ------------------------------------------------------------------------------

# Endereço IP padrão da câmera inicial na rede local
# DEFAULT_CAMERA_IP=192.168.1.100

# Porta RTSP padrão da câmera inicial (Padrão: 554)
DEFAULT_CAMERA_PORT=554

# Usuário padrão da câmera inicial (Padrão: admin)
DEFAULT_CAMERA_USER=admin

# Senha padrão da câmera inicial (será criptografada com AES-256-GCM ao salvar)
# DEFAULT_CAMERA_PASS=

# IPs alternativos para contingência automática de DHCP na inicialização legada
# CAMERA_FALLBACK_IPS=192.168.1.101,192.168.1.102
